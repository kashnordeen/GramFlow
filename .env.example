DATABASE_URL=postgresql://gramflow:gramflow@localhost:5432/gramflow
TEST_DATABASE_URL=postgresql://gramflow:gramflow@localhost:5432/gramflow_test
DATABASE_SSL=false
DB_POOL_MAX=10
JWT_SECRET=replace-with-at-least-32-random-characters
REGISTRATION_CODE=replace-with-a-private-registration-code
ALLOWED_EMAIL_DOMAIN=hemp.com
# Optional Google Workspace sign-in/signup. Register the exact callback URL in Google Cloud.
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-web-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Optional development seed administrator (uncomment all three to enable)
# SEED_ADMIN_EMAIL=admin@hemp.com
# SEED_ADMIN_PASSWORD=replace-with-a-strong-password
# SEED_ADMIN_NAME=Administrator
# Optional demo fixtures (uncomment only for a disposable local database)
# DEMO_SEED_PASSWORD=replace-with-a-strong-demo-only-password
